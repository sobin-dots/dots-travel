# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plivo_db?schema=public

# Application URLs
PUBLIC_BASE_URL=http://localhost:3000

# Auth.js / NextAuth
AUTH_SECRET=

# JWT & Tokens
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Credential Encryption (AES-256-GCM)
ENCRYPTION_KEK=
ENCRYPTION_KEK_VERSION=1

# Media Proxy Signed URLs
MEDIA_URL_SECRET=
MEDIA_URL_TTL_SECONDS=300

# Telephony Mode (simulator | live)
TELEPHONY_MODE=simulator

# Plivo Credentials (Mandatory only when TELEPHONY_MODE=live)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_WEBHOOK_AUTH_TOKEN=

# Rate Limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=5000

# Seed Defaults
SEED_OWNER_EMAIL=admin@example.com
SEED_OWNER_PASSWORD=

# Resend Email Integration (Obtain key from https://resend.com/api-keys)
# For development/testing with free tier, use "onboarding@resend.dev"
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# DeepSeek AI Travel Concierge (Obtain key from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
